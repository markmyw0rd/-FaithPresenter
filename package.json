{
  "name": "faithpresenter",
  "productName": "FaithPresenter",
  "version": "0.16.0",
  "description": "FaithPresenter Studio — docked presentation workspace",
  "author": "FaithPresenter",
  "private": true,
  "main": "dist/desktop/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && tsc -p tsconfig.desktop.json && vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:visual": "npm run build && node scripts/test-visual.mjs",
    "package": "npm run build && electron-forge package",
    "make:windows": "npm run build && electron-forge make --platform=win32 --arch=x64",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "10.4.20",
    "electron": "44.1.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "^5.9.0",
    "vite": "8.1.3"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
